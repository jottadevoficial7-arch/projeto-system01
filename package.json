{
  "name": "the-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-storage.ts",
    "db:import-sqlite": "node --env-file-if-exists=.env.local --import tsx scripts/import-sqlite.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
