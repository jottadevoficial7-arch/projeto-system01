# Node.js 24.x. PostgreSQL is required in development and on Vercel.
# Fill DATABASE_URL with the actual connection URL (pooled on Vercel).
# Never prefix database variables with NEXT_PUBLIC_. Never commit credentials.
DATABASE_URL=
# Optional: direct administrator connection, only for migration commands.
# DATABASE_DIRECT_URL=
# POSTGRES_URL is accepted when DATABASE_URL is absent (some integrations use it).

# Local Docker Compose only. Choose a password, then use the same password in
# DATABASE_URL=postgresql://the_system:URL_ENCODED_PASSWORD@127.0.0.1:5432/the_system
POSTGRES_PASSWORD=

# false for local HTTP; true for production HTTPS.
COOKIE_SECURE=false
# Production: use the real public origin, without a path.
# APP_ORIGIN=https://your-actual-domain.example

# Integration tests require a separate local database ending in _test.
# TEST_DATABASE_URL=
